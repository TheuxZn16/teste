# =============================================================================
# Variáveis de Ambiente — Exemplo
# =============================================================================
# Copie para .env e preencha os valores.
# NUNCA commit o .env com credenciais reais.
# =============================================================================

# --- Banco de Dados ---
DB_USER=motivafit
DB_PASSWORD=motivafit_pass
DB_DATABASE=motivafit

# --- JWT ---
# Gere uma chave segura: openssl rand -base64 64
JWT_SECRET=dGVzdC1zZWNyZXQta2V5LWZvci1kZXZlbG9wbWVudC1vbmx5LWhhbmdlLXRoaXMh
JWT_ISSUER=motivafit-dev
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Backend ---
CORS_ALLOWED_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SUPERUSUARIO_EMAIL=superusuario@motivafit.com
SUPERUSUARIO_SENHA=SenhaBootstrap123!

# --- Frontend ---
# Deixe vazio para usar /api na mesma origem (proxy)
VITE_API_BASE_URL=
